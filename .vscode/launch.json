{
  // Create the venv once before using these:
  //   python -m venv .venv && .venv/bin/pip install -r requirements-dev.txt
  // All configs use .venv in this
  // folder and run from the project root, because rag.py uses relative paths
  // (data/, models/) and reads .env from the working directory.
  "version": "0.2.0",
  "configurations": [
    {
      // The bot as you'd run it from a terminal: python main.py. Interactive
      // input() loop, so it needs the integrated terminal. Needs .env.
      "name": "RAGBot: main.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "TOKENIZERS_PARALLELISM": "false" },
      "justMyCode": false
    },
    {
      // Retrieval eval: python -m eval.retrieval [flags]. Asks which flags to
      // pass each time it starts (see the docstring in eval/retrieval.py).
      "name": "Eval: retrieval",
      "type": "debugpy",
      "request": "launch",
      "module": "eval.retrieval",
      "args": "${input:evalRetrievalArgs}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "TOKENIZERS_PARALLELISM": "false" },
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "evalRetrievalArgs",
      "type": "pickString",
      "description": "Flags for python -m eval.retrieval",
      "options": [
        { "label": "report only", "value": "" },
        { "label": "--show (top-3 chunks for each miss)", "value": "--show" },
        { "label": "--update-baseline (write eval/baselines/retrieval.json)", "value": "--update-baseline" }
      ],
      "default": ""
    }
  ]
}
