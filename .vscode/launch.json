{
  // Create the venv once before using these:
  //   uv sync --extra dev   (or make install-dev; make install-eval for the LLM eval)
  // All configs use .venv in this
  // folder and run from the project root, because rag.py uses relative paths
  // (data/, models/) and reads .env from the working directory.
  "version": "0.2.0",
  "configurations": [
    {
      // The bot as you'd run it from a terminal: python main.py. Interactive
      // input() loop, so it needs the integrated terminal. Needs .env.
      "name": "RAGBot: main.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "TOKENIZERS_PARALLELISM": "false" },
      "justMyCode": false
    },
    {
      // Same as above, with traces sent to the local Langfuse (make langfuse-up
      // first; the keys are the local project's, see docker-compose.yml). Like
      // make run-langfuse-local.
      "name": "RAGBot: main.py (local Langfuse)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "TOKENIZERS_PARALLELISM": "false",
        "LANGFUSE_ENABLED": "true",
        "LANGFUSE_HOST": "http://localhost:3100",
        "LANGFUSE_PUBLIC_KEY": "pk-lf-local-mini-rag",
        "LANGFUSE_SECRET_KEY": "sk-lf-local-mini-rag"
      },
      "justMyCode": false
    },
    {
      // Retrieval eval: python -m eval.retrieval [flags]. Asks which flags to
      // pass each time it starts (see the docstring in eval/retrieval/__main__.py).
      "name": "Eval: retrieval",
      "type": "debugpy",
      "request": "launch",
      "module": "eval.retrieval",
      "args": "${input:evalRetrievalArgs}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "TOKENIZERS_PARALLELISM": "false" },
      "justMyCode": false
    },
    {
      // Retrieval eval published to the local Langfuse: python -m eval.retrieval
      // --langfuse (make langfuse-up first). Asks for the chunk size and a run
      // name; compare runs in Langfuse → Datasets → mini-rag-retrieval → Runs.
      // Like make eval-retrieval-langfuse-local.
      "name": "Eval: retrieval (local Langfuse)",
      "type": "debugpy",
      "request": "launch",
      "module": "eval.retrieval",
      "args": "--langfuse ${input:retrievalChunkSize} --run-name ${input:retrievalRunName}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "TOKENIZERS_PARALLELISM": "false",
        "LANGFUSE_HOST": "http://localhost:3100",
        "LANGFUSE_PUBLIC_KEY": "pk-lf-local-mini-rag",
        "LANGFUSE_SECRET_KEY": "sk-lf-local-mini-rag"
      },
      "justMyCode": false
    },
    {
      // LLM eval: python -m eval.llm. Calls paid APIs: needs
      // the eval extra installed (make install-eval) and OPENAI_API_KEY + ANTHROPIC_API_KEY
      // in .env. Asks for the scope and a run name; compare runs with mlflow ui.
      "name": "Eval: LLM judges (local mlflow)",
      "type": "debugpy",
      "request": "launch",
      "module": "eval.llm",
      "args": "${input:llmEvalScope} --run-name ${input:llmEvalRunName}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "TOKENIZERS_PARALLELISM": "false" },
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "llmEvalScope",
      "type": "pickString",
      "description": "Questions for python -m eval.llm",
      "options": [
        { "label": "--limit 3 (smoke test)", "value": "--limit 3" },
        { "label": "all questions", "value": "" }
      ],
      "default": "--limit 3"
    },
    {
      "id": "llmEvalRunName",
      "type": "promptString",
      "description": "MLflow run name (no spaces)",
      "default": "smoke"
    },
    {
      "id": "evalRetrievalArgs",
      "type": "pickString",
      "description": "Flags for python -m eval.retrieval",
      "options": [
        { "label": "report only", "value": "" },
        { "label": "--update-baseline (write eval/baselines/retrieval.json)", "value": "--update-baseline" },
        { "label": "--mlflow (also log the run to MLflow)", "value": "--mlflow" }
      ],
      "default": ""
    },
    {
      "id": "retrievalChunkSize",
      "type": "pickString",
      "description": "Chunk size for python -m eval.retrieval --langfuse",
      "options": [
        { "label": "default (80)", "value": "" },
        { "label": "--chunk-size 120", "value": "--chunk-size 120" },
        { "label": "--chunk-size 160", "value": "--chunk-size 160" }
      ],
      "default": ""
    },
    {
      "id": "retrievalRunName",
      "type": "promptString",
      "description": "Langfuse run name (no spaces), e.g. chunk-120",
      "default": "chunk-80"
    }
  ]
}
