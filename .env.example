# Choose ONE provider. Retrieval and tests work without a real key.

# Option 1: OpenAI
OPENAI_API_KEY=
MODEL_NAME=gpt-4.1-mini

# Option 2: Azure OpenAI (used whenever AZURE_OPENAI_ENDPOINT is set)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# OPENAI_API_VERSION=2024-10-21
# MODEL_NAME=<your Azure deployment name>

TOKENIZERS_PARALLELISM=false

# LLM eval only (python -m eval.llm, needs the eval extra: uv sync --extra dev --extra eval)
ANTHROPIC_API_KEY=
# JUDGE_MODEL=anthropic:/claude-haiku-5-5

# Tracing (optional). Off unless LANGFUSE_ENABLED=true; LANGFUSE_HOST must match the keys' region.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Or the local Langfuse (make langfuse-up), whose project and keys are created on first start:
# LANGFUSE_PUBLIC_KEY=pk-lf-local-mini-rag
# LANGFUSE_SECRET_KEY=sk-lf-local-mini-rag
# LANGFUSE_HOST=http://localhost:3100
# RAGBOT_USER_ID=          # defaults to the OS user name
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # every span to Jaeger (docker compose --profile obs)
